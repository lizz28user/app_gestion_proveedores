# Clave secreta para crear el PRIMER administrador (solo usar una vez)
# Genera una clave segura: openssl rand -hex 32
ADMIN_SEED_KEY=tu_clave_secreta_aqui

# Entorno
NODE_ENV=development

# Solo para publicar en la nube (Vercel + Upstash Redis).
# En tu equipo se deja vacio y los usuarios se guardan en data/usuarios.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
