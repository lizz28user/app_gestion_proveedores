{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "firebase": {
        "type": "local",
        "command": [
          "firebase",
          "mcp",
          "--only",
          "core,crashlytics,functions"
        ],
        "disabled": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp",
        "disabled": false
      },
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ],
        "disabled": false
      }
    }
  }
}