{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "display": "inline-flex",
    "align-items": "center",
    "padding": "2px 10px",
    "border-radius": "12px",
    "font-size": "12px",
    "font-weight": "600",
    "color": "=if(@currentField == 'Vigente', '#1E7D4A', if(@currentField == 'Vencida', '#B32515', '#8A6000'))",
    "background-color": "=if(@currentField == 'Vigente', '#DDF4E7', if(@currentField == 'Vencida', '#FDE2DF', if(@currentField == 'No homologado', '#FFF2CC', 'transparent')))"
  },
  "children": [
    {
      "elmType": "span",
      "txtContent": "=if(@currentField == 'Vigente', '✓ ', if(@currentField == 'Vencida', '✕ ', if(@currentField == 'No homologado', '○ ', '')))"
    },
    {
      "elmType": "span",
      "txtContent": "@currentField"
    }
  ]
}
